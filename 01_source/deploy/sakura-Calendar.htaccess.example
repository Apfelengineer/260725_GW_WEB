# 共有Apache向け静的Calendar。PHPやディレクトリ一覧を公開しません。
Options -Indexes
DirectoryIndex index.html
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar)(/|$)">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set Cache-Control "no-store"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'"
</IfModule>
