# 内部サーバーでPHPと定期送信サービスへ設定する値です。秘密鍵は実値へ置換し、権限600で保存します。
KPTC_INTERNAL_SCHEDULER_DB=/var/lib/kptc-scheduler/group-watcher.sqlite
# renkonとoriginで同じ元文字列を設定します。プログラムがSHA-256で32バイト鍵へ変換します。
KPTC_PORTAL_TOKEN_KEY=SecretKey999
KPTC_PUBLIC_AVAILABILITY_MODE=https
KPTC_PUBLIC_AVAILABILITY_ENDPOINT=https://availability.example.jp/receive-availability.php
KPTC_PUBLIC_AVAILABILITY_PAGE_URL=https://availability.example.jp/calendar
KPTC_PUBLIC_AVAILABILITY_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
KPTC_PUBLIC_AVAILABILITY_TIMEOUT=10
KPTC_PUBLIC_AVAILABILITY_STALE_SECONDS=1800
KPTC_SESSION_COOKIE_SECURE=1
KPTC_AUTH_IDLE_TIMEOUT=1800
KPTC_AUTH_ABSOLUTE_TIMEOUT=43200
