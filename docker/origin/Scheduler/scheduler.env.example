# /etc/kptc/scheduler.env へコピーし、秘密値・ブラウザ用URLを実環境へ変更します。
KPTC_PORTAL_TOKEN_KEY=REPLACE_WITH_A_LONG_RANDOM_PORTAL_SECRET
KPTC_PUBLIC_AVAILABILITY_PAGE_URL=https://origin.example.jp/Calendar/
KPTC_PUBLIC_AVAILABILITY_JSON=/var/lib/kptc-outbox/public-availability.json
KPTC_AVAILABILITY_STATUS_JSON=/var/lib/kptc-publish-status/status.json
KPTC_PUBLIC_AVAILABILITY_STALE_SECONDS=1800
# http://origin:8080/ への直接接続用。HTTPS /Scheduler/ 経由なら1と/Scheduler/。
KPTC_SESSION_COOKIE_SECURE=0
KPTC_SESSION_COOKIE_PATH=/
KPTC_AUTH_IDLE_TIMEOUT=1800
KPTC_AUTH_ABSOLUTE_TIMEOUT=43200
