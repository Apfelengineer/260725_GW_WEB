[Unit]
Description=Back up KPTC current and future schedules to latest JSON

[Service]
Type=oneshot
User=www-data
Group=www-data
EnvironmentFile=/etc/kptc-scheduler/internal-server.env
ExecStart=/usr/bin/php /opt/kptc-scheduler/internal/current/backup-scheduler-cli.php
UMask=0077
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/kptc-scheduler
